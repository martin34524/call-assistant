# Copy to .env and fill in. Not committed (see .gitignore).
# Run `source .env` before `mix phx.server` to load these.

# Leave both unset to use the mock CALL-E adapter (default, no real calls placed).
# Set both to switch to the live adapter - see lib/call_assistant/call_e/live.ex
# for important caveats about the unconfirmed REST endpoint shape.
export CALLE_API_BASE_URL=
export CALLE_API_KEY=
